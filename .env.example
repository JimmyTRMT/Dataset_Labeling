# App security (mandatory in production)
SECRET_KEY=replace-with-a-strong-random-secret

# Database connection (default: SQLite at database/dataset.db)
DATABASE_URL=sqlite:///database/dataset.db

# Upload and export folders (relative paths are resolved from the project root)
UPLOAD_FOLDER=./data/images
EXPORT_FOLDER=./data/exports

# Available labels (comma-separated)
AVAILABLE_LABELS=No DR,Mild,Moderate,Severe

# Debug mode (true / 1 / yes / on to enable)
FLASK_DEBUG=false
